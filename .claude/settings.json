{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "$raw = [Console]::In.ReadToEnd(); $json = $raw | ConvertFrom-Json; if ($json.tool_input.file_path -match '\\.cs$') { dotnet test 'C:\\Projects\\taskmanager-api\\TaskManager.Api.Tests' --verbosity quiet }",
            "timeout": 30,
            "statusMessage": "Running unit tests..."
          }
        ]
      }
    ]
  }
}
