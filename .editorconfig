root = true

# ── All files ─────────────────────────────────────────────────────────────────
[*]
indent_style = space
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# ── C# ────────────────────────────────────────────────────────────────────────
[*.cs]
indent_size = 4

# Namespace style — file-scoped (already used throughout)
csharp_style_namespace_declarations = file_scoped:warning

# Usings — System.* first, then alphabetical
dotnet_sort_system_directives_first = true

# var — use when type is obvious from the right-hand side, otherwise spell it out
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression-bodied members — allow on single-line methods and properties
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# Braces — require for all blocks to avoid dangling-else bugs
csharp_prefer_braces = when_multiline:warning

# Nullable — promote warnings to errors so Nullable>enable has teeth
dotnet_diagnostic.CS8600.severity = error   # null assigned to non-nullable
dotnet_diagnostic.CS8601.severity = error   # null passed to non-nullable ref param
dotnet_diagnostic.CS8602.severity = error   # dereference of possibly null ref
dotnet_diagnostic.CS8603.severity = error   # possible null reference return
dotnet_diagnostic.CS8604.severity = error   # null passed as non-nullable argument
dotnet_diagnostic.CS8618.severity = error   # non-nullable field uninitialized
dotnet_diagnostic.CS8625.severity = error   # null literal → non-nullable ref type

# ── MSBuild project files ─────────────────────────────────────────────────────
[*.{csproj,props,targets}]
indent_size = 2

# ── JSON ──────────────────────────────────────────────────────────────────────
[*.json]
indent_size = 2

# ── Markdown ──────────────────────────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false
